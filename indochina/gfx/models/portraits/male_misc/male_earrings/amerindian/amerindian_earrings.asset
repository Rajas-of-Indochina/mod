entity = {
	name = "male_amerindian_earrings_13a_entity"
	pdxmesh = "male_amerindian_earrings_13a_mesh"

	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/attachments/male_headgears/meso_headgear/male_meso_headgear_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "totomec_common_01"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
	
}
